---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { DATA } from "@/data/resume";
import { mdxComponents } from "@/mdx-components";
import { ArrowLeft, ArrowUpRight, ChevronLeft, ChevronRight } from "lucide-react";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const projectOrder = [
    "slootea",
    "employcase",
    "unheil",
    "cereverse-scape",
    "cheat-classification-platform",
    "cnn-implementation",
    "genetic-algorithm-implementation",
    "suspicious-and-toxic-discussion-classification",
    "dhmi-plane-game",
    "sidre-beauty-website",
    "turkcell-business-model-canvas",
  ];

  const sortedProjects = [...projects].sort((a, b) => {
    const indexA = projectOrder.indexOf(a.id);
    const indexB = projectOrder.indexOf(b.id);
    if (indexA !== -1 && indexB !== -1) return indexA - indexB;
    if (indexA !== -1) return -1;
    if (indexB !== -1) return 1;
    return 0;
  });

  return sortedProjects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      previousProject: index > 0 ? sortedProjects[index - 1] : null,
      nextProject: index < sortedProjects.length - 1 ? sortedProjects[index + 1] : null,
    },
  }));
}

const { project, previousProject, nextProject } = Astro.props;
const { title, dates, summary, technologies, image, video, explainerVideo, links } = project.data;
const slug = project.id;

const BASE_PATH = import.meta.env.BASE_URL || "/";
const withBasePath = (path = "") => {
  const base = BASE_PATH.endsWith("/") ? BASE_PATH : `${BASE_PATH}/`;
  const cleanPath = path.replace(/^\/+/, "");
  return `${base}${cleanPath}`;
};

const projectImage = image
  ? image.startsWith("http")
    ? image
    : withBasePath(image)
  : DATA.ogImage;
const projectVideo = video
  ? video.startsWith("http")
    ? video
    : withBasePath(video)
  : "";

const explainerEmbed = (() => {
  if (!explainerVideo) return null;
  const youtubeMatch = explainerVideo.match(
    /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/
  );
  if (youtubeMatch) {
    return { type: "iframe" as const, src: `https://www.youtube.com/embed/${youtubeMatch[1]}` };
  }
  const vimeoMatch = explainerVideo.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vimeoMatch) {
    return { type: "iframe" as const, src: `https://player.vimeo.com/video/${vimeoMatch[1]}` };
  }
  if (/\.(mp4|webm|ogg)$/i.test(explainerVideo)) {
    return {
      type: "video" as const,
      src: explainerVideo.startsWith("http") ? explainerVideo : withBasePath(explainerVideo),
    };
  }
  return { type: "iframe" as const, src: explainerVideo };
})();

const { Content } = await render(project);
const projectLinks = links ?? [];
---

<Layout
  title={title}
  description={summary}
  image={projectImage}
  canonicalURL={`${DATA.url}/projects/${slug}`}
>
  <section class="mx-auto max-w-3xl py-8">
    <div class="flex justify-start gap-4 items-center">
      <a
        href={withBasePath()}
        class="text-sm text-muted-foreground hover:text-foreground transition-colors border border-border rounded-lg px-3 py-1.5 inline-flex items-center gap-2 mb-8 group"
      >
        <ArrowLeft className="size-4 group-hover:-translate-x-0.5 transition-transform" />
        Back home
      </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-border bg-card mb-8">
      {projectVideo ? (
        <video src={projectVideo} autoplay loop muted playsinline class="w-full h-72 object-cover" />
      ) : projectImage ? (
        <img src={projectImage} alt={title} class="w-full h-72 object-cover" />
      ) : (
        <div class="h-72 w-full bg-muted" />
      )}
    </div>

    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <p class="text-sm text-muted-foreground">{dates}</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">{title}</h1>
      </div>
      {projectLinks.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {projectLinks.map((link: { href: string; type?: string }) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-3 py-1.5 text-sm hover:bg-accent transition-colors"
            >
              <span>{link.type}</span>
              <ArrowUpRight className="size-3.5" />
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="mb-8 flex flex-wrap gap-2">
      {technologies.map((tech: string) => (
        <span
          class={`rounded-full border px-2.5 py-1 text-xs ${
            tech.includes("Pre-LLM")
              ? "border-amber-500/40 bg-amber-500/10 text-amber-700 dark:text-amber-300 font-semibold"
              : "border-border text-muted-foreground"
          }`}
        >
          {tech}
        </span>
      ))}
    </div>

    <div class="my-6 flex w-full items-center">
      <div
        class="flex-1 h-px bg-border"
        style="mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);"
      >
      </div>
    </div>

    {explainerEmbed && (
      <div class="mb-8">
        <h2 class="mb-3 text-lg font-semibold tracking-tight">Explainer Video</h2>
        <div class="overflow-hidden rounded-2xl border border-border bg-card">
          <div class="relative aspect-video w-full">
            {explainerEmbed.type === "video" ? (
              <video
                src={explainerEmbed.src}
                controls
                class="absolute inset-0 h-full w-full object-cover"
              />
            ) : (
              <iframe
                src={explainerEmbed.src}
                title={`${title} explainer video`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="absolute inset-0 h-full w-full"
              />
            )}
          </div>
        </div>
      </div>
    )}

    <article class="prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground dark:prose-invert">
      <Content components={mdxComponents} />
    </article>

    <nav class="mt-12 pt-8 border-t border-border">
      <div class="flex flex-col sm:flex-row justify-between gap-4">
        {
          previousProject ? (
            <a
              href={withBasePath(`projects/${previousProject.id}`)}
              class="group flex flex-col gap-1 text-left sm:max-w-[48%]"
            >
              <span class="text-xs text-muted-foreground flex items-center gap-1">
                <ChevronLeft className="size-3" />
                Previous Project
              </span>
              <span class="text-sm font-medium text-foreground group-hover:underline line-clamp-1">
                {previousProject.data.title}
              </span>
            </a>
          ) : (
            <div />
          )
        }
        {
          nextProject ? (
            <a
              href={withBasePath(`projects/${nextProject.id}`)}
              class="group flex flex-col gap-1 text-right sm:max-w-[48%] sm:ml-auto"
            >
              <span class="text-xs text-muted-foreground flex items-center gap-1 justify-end">
                Next Project
                <ChevronRight className="size-3" />
              </span>
              <span class="text-sm font-medium text-foreground group-hover:underline line-clamp-1">
                {nextProject.data.title}
              </span>
            </a>
          ) : (
            <div />
          )
        }
      </div>
    </nav>
      </div>
    </nav>
  </section>
</Layout>
