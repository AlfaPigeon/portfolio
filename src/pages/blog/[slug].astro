---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { DATA } from "@/data/resume";
import { formatDate } from "@/lib/utils";
import { mdxComponents } from "@/mdx-components";
import { ChevronLeft, ChevronRight } from "lucide-react";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sortedPosts = [...posts].sort((a, b) => {
    if (new Date(a.data.publishedAt) > new Date(b.data.publishedAt)) return -1;
    return 1;
  });
  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost: index > 0 ? sortedPosts[index - 1] : null,
      nextPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
    },
  }));
}

const { post, previousPost, nextPost } = Astro.props;
const { title, publishedAt, summary, image } = post.data;
const slug = post.id;

const BASE_PATH = import.meta.env.BASE_URL || "/";
const withBasePath = (path = "") => {
  const base = BASE_PATH.endsWith("/") ? BASE_PATH : `${BASE_PATH}/`;
  const cleanPath = path.replace(/^\/+/, "");
  return `${base}${cleanPath}`;
};

const { Content, headings } = await render(post);
const tableOfContents = headings.filter(({ depth }) => depth >= 2 && depth <= 4);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: publishedAt,
  dateModified: publishedAt,
  description: summary,
  image: image
    ? image.startsWith("http")
      ? image
      : `${DATA.url}${image}`
    : `${DATA.url}/og_image.png`,
  url: `${DATA.url}/blog/${slug}`,
  author: {
    "@type": "Person",
    name: DATA.name,
  },
}).replace(/</g, "\\u003c");
---

<Layout
  title={title}
  description={summary}
  image={image}
  canonicalURL={`${DATA.url}/blog/${slug}`}
  wide
>
  <section id="blog">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <div class="flex justify-start gap-4 items-center">
      <a
        href={withBasePath("blog")}
        class="text-sm text-muted-foreground hover:text-foreground transition-colors border border-border rounded-lg px-2 py-1 inline-flex items-center gap-1 mb-6 group"
        aria-label="Back to Blog"
      >
        <ChevronLeft
          className="size-3 group-hover:-translate-x-px transition-transform"
        />
        Back to Blog
      </a>
    </div>
    <div class="flex flex-col gap-4">
      <h1
        class="title font-semibold text-3xl md:text-4xl tracking-tighter leading-tight"
      >
        {title}
      </h1>
      <p class="text-sm text-muted-foreground">
        {formatDate(publishedAt)}
      </p>
    </div>
    <div class="my-6 flex w-full items-center">
      <div
        class="flex-1 h-px bg-border"
        style="mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);"
      >
      </div>
    </div>
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-12 lg:items-start">
      <article
        class="prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground dark:prose-invert"
      >
        <Content components={mdxComponents} />
      </article>

      {
        tableOfContents.length > 0 && (
          <aside class="hidden lg:block sticky top-8" aria-label="Table of contents">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-foreground">
              On this page
            </p>
            <nav>
              <ol class="m-0 list-none space-y-2 border-l border-border pl-4 text-sm">
                {tableOfContents.map((heading) => (
                  <li class={heading.depth > 2 ? "pl-3" : undefined}>
                    <a
                      href={`#${heading.slug}`}
                      class="text-muted-foreground no-underline hover:text-foreground transition-colors"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>

    <nav class="mt-12 pt-8 max-w-2xl">
      <div class="flex flex-col sm:flex-row justify-between gap-4">
        {
          previousPost ? (
            <a
              href={withBasePath(`blog/${previousPost.id}`)}
              class="group flex-1 flex flex-col gap-1 p-4 rounded-lg border border-border hover:bg-accent/50 transition-colors"
            >
              <span class="flex items-center gap-1 text-xs text-muted-foreground">
                <ChevronLeft className="size-3" />
                Previous
              </span>
              <span class="text-sm font-medium group-hover:text-foreground transition-colors whitespace-normal wrap-break-word">
                {previousPost.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block flex-1" />
          )
        }

        {
          nextPost ? (
            <a
              href={withBasePath(`blog/${nextPost.id}`)}
              class="group flex-1 flex flex-col gap-1 p-4 rounded-lg border border-border hover:bg-accent/50 transition-colors text-right"
            >
              <span class="flex items-center justify-end gap-1 text-xs text-muted-foreground">
                Next
                <ChevronRight className="size-3" />
              </span>
              <span class="text-sm font-medium group-hover:text-foreground transition-colors whitespace-normal wrap-break-word">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block flex-1" />
          )
        }
      </div>
    </nav>
  </section>

  <script>
    import mermaid from "mermaid";

    const mermaidBlocks = document.querySelectorAll<HTMLElement>(
      '[data-code-block="mermaid"]',
    );

    if (mermaidBlocks.length > 0) {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: document.documentElement.classList.contains("dark")
          ? "dark"
          : "default",
      });

      for (const [index, block] of mermaidBlocks.entries()) {
        const source = block.querySelector("code")?.textContent?.trim();
        const pre = block.querySelector("pre");

        if (!source || !pre) continue;

        try {
          const { svg, bindFunctions } = await mermaid.render(
            `mermaid-diagram-${index}`,
            source,
          );
          const diagram = document.createElement("div");
          diagram.className = "mermaid-diagram overflow-x-auto p-4";
          diagram.innerHTML = svg;
          pre.replaceWith(diagram);
          block.querySelector("button")?.remove();
          bindFunctions?.(diagram);
        } catch (error) {
          console.error("Unable to render Mermaid diagram", error);
        }
      }
    }
  </script>
</Layout>
